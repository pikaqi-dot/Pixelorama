
# Godot-specific ignores
.import/
.godot/
override.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.directory
*~

# Visual Studio Code ignores
.vscode/

# AI assistant workspace files
.roo/

# Local scratch files (temporary validation scenes/scripts)
_tmp_*

# Export build output
/build/
# Godot writes its export progress here while an export runs
/_export.log

# LAN sync default shared folder, filled by whatever the phone sends
/lan_shared/

# macOS ignores
.DS_Store

# Windows ignores
Thumbs.db
desktop.ini

# Android ignores
android/

addons/godotsteam
